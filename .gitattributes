# ============================================================================
# IFMap - Atributos do Git
# ============================================================================

# Normaliza fim de linha para LF em qualquer arquivo de texto detectado
* text=auto eol=lf

# ----------------------------------------------------------------------------
# Arquivos binários (nunca sofrem conversão de fim de linha)
# ----------------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.sqlite binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# ----------------------------------------------------------------------------
# Scripts que exigem LF mesmo em checkout no Windows
# ----------------------------------------------------------------------------
*.sh text eol=lf
artisan text eol=lf
Makefile text eol=lf

# ----------------------------------------------------------------------------
# Estatísticas de linguagem do GitHub (linguist)
# Lockfiles e documentação não devem dominar o gráfico de linguagens.
# ----------------------------------------------------------------------------
package-lock.json linguist-generated=true -diff
composer.lock linguist-generated=true -diff
docs/** linguist-documentation=true
*.md linguist-documentation=true

# ----------------------------------------------------------------------------
# Arquivos irrelevantes em tarballs de release (git archive)
# ----------------------------------------------------------------------------
/.github export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/docs export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
